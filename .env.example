# 서버가 구현되면 읽기 전용 내부 API를 연결합니다. 브라우저에는 노출하지 마세요.
FARM_API_BASE_URL=http://localhost:3000
FARM_AGENT_API_TOKEN=replace-with-server-side-token
# eve 모델 인증은 로컬 /login 또는 Vercel AI Gateway 설정을 사용합니다.

# 웹페이지의 AI 추천 API: 서버 환경에만 설정하고 브라우저 코드에는 넣지 마세요.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Vercel 계정 인증에 사용할 서버 환경 변수입니다. 로컬 SQLite 실행에는 필요 없습니다.
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
